{
  "name": "bubble-backend",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "seed": "bun run src/database/seed/seed.ts",
    "seed:website": "bun run src/database/seed/seed-website.ts",
    "migrate:uploads": "bun run src/database/scripts/migrate-data-urls-to-uploads.ts",
    "migrate:uploads:dry": "bun run src/database/scripts/migrate-data-urls-to-uploads.ts --dry-run",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/__tests__"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.29",
    "mongoose": "8.19.1",
    "zod": "^4.4.3"
  }
}
