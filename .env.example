# Separated secrets — never reuse one key for multiple purposes
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
FIELD_ENCRYPTION_KEY=change-me-field-encryption-key
COOKIE_SECRET=change-me-cookie-secret
API_SIGNATURE_SECRET=change-me-api-signature-secret

PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018/bubble

# Comma-separated browser origins allowed to call the API (no trailing slash)
# Local:
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
# Production example:
# CORS_ORIGIN=https://bubble-iq.com,https://www.bubble-iq.com,https://admin.bubble-iq.com

# Bootstrap: required header X-Bootstrap-Key; keep false in production unless intentionally enabling
ADMIN_BOOTSTRAP_KEY=change-me-bootstrap-key
BOOTSTRAP_ENABLED=false

# Storefront Google Sign-In (OAuth Web client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=
